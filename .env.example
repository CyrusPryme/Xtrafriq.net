# Copy this file to .env.local and fill in your values

# Contact – used on contact section, Privacy, and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=your-email@example.com

# Resend – required for contact form (get key at https://resend.com/api-keys)
RESEND_API_KEY=

# Optional: "From" address for contact form (default: onboarding@resend.dev)
# RESEND_FROM_EMAIL=Xtrafriq Contact <hello@yourdomain.com>

# Optional: canonical site URL for metadata, sitemap, robots, and OG/Twitter tags.
# Defaults to https://xtrafriq-net.vercel.app (the current production host).
# Set this to https://xtrafriq.com only after that domain actually resolves.
# NEXT_PUBLIC_SITE_URL=https://xtrafriq-net.vercel.app

# Optional: contact phone
# NEXT_PUBLIC_CONTACT_PHONE=+233243879212

# Optional: social profiles (used for SEO structured data)
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_TWITTER=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
